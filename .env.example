# Tarayıcıda kullanılabilen Supabase proje bilgileri
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Yalnızca sunucu/Vercel secret olarak tanımlayın. NEXT_PUBLIC_ kullanmayın.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# En az 32 rastgele bayttan oluşan Google Form webhook HMAC anahtarı
GOOGLE_FORM_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Vercel Cron isteklerini doğrulayan en az 32 baytlık sunucu secret'ı
CRON_SECRET=replace-with-a-long-random-secret

# 32 rastgele baytın base64 çıktısı; zamanlanmış yedekleri AES-256-GCM ile şifreler
BACKUP_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Gerçek e-posta sağlanana kadar kapalıdır. `resend` için aşağıdaki üç secret gerekir.
MESSAGE_PROVIDER=disabled
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Nobel Vize <iletisim@nobelvize.com>
EMAIL_REPLY_TO=muradvize@gmail.com

# Resend Dashboard webhook signing secret'ı (whsec_ ile başlar).
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx

# Google Calendar OAuth: Vercel'de redirect URI olarak
# https://alanadiniz/api/integrations/google-calendar/callback tanimlanmalidir.
NEXT_PUBLIC_APP_URL=https://abidinyildiz.com
GOOGLE_CALENDAR_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=replace-with-google-oauth-client-secret
# En az 32 baytlik OAuth state HMAC anahtari
GOOGLE_CALENDAR_STATE_SECRET=replace-with-a-long-random-secret
# 32 rastgele baytin base64 ciktisi; Google tokenlari AES-256-GCM ile sifreler.
CALENDAR_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Gerçek sağlayıcı webhook'u açıldığında en az 32 baytlık HMAC secret'ı
MESSAGE_WEBHOOK_SECRET=replace-only-when-provider-is-approved

# Yalnızca kontrollü bakım penceresinde ve doğrulanmış v2 yedekle true yapın.
ENABLE_ATOMIC_RESTORE=false
