# Tarayıcıda kullanılabilen Supabase proje bilgileri
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Yalnızca sunucu/Vercel secret olarak tanımlayın. NEXT_PUBLIC_ kullanmayın.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# En az 32 rastgele bayttan oluşan Google Form webhook HMAC anahtarı
GOOGLE_FORM_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Vercel Cron isteklerini doğrulayan en az 32 baytlık sunucu secret'ı
CRON_SECRET=replace-with-a-long-random-secret

# 32 rastgele baytın base64 çıktısı; zamanlanmış yedekleri AES-256-GCM ile şifreler
BACKUP_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Faz 4.5 sağlayıcı kararı verilene kadar kapalı kalmalıdır.
MESSAGE_PROVIDER=disabled

# Gerçek sağlayıcı webhook'u açıldığında en az 32 baytlık HMAC secret'ı
MESSAGE_WEBHOOK_SECRET=replace-only-when-provider-is-approved

# Yalnızca kontrollü bakım penceresinde ve doğrulanmış v2 yedekle true yapın.
ENABLE_ATOMIC_RESTORE=false
