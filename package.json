{
  "name": "antigravity-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:unit": "tsx --test tests/report-metrics.test.ts",
    "test:security": "tsx --test tests/security-regressions.test.ts tests/webhook-signature.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:local": "sh scripts/run-e2e-local.sh",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --schema public --level warning",
    "db:test": "supabase test db",
    "restore:drill": "sh scripts/run-isolated-restore-drill.sh",
    "release:verify": "sh scripts/verify-release-candidate.sh",
    "production:verify": "sh scripts/verify-production.sh",
    "quality": "npm run lint && npm run typecheck && npm test && npm run audit:production && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.9",
    "@types/papaparse": "^5.5.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.4",
    "pdf-lib": "^1.17.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "read-excel-file": "^9.3.4",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "next": {
      "sharp": "0.35.3"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "supabase": "^2.110.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "ws": "^8.21.1"
  }
}
