{
  "description": "Read-only worktree snapshot on session startup; no tests, edits or network calls. Review and trust via /hooks before use.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^startup$",
        "hooks": [
          {
            "type": "command",
            "command": "git status --short --branch",
            "timeout": 3,
            "statusMessage": "Checking the existing worktree",
            "additionalContextLimit": 500
          }
        ]
      }
    ]
  }
}
